# AREVÉ storefront environment. Copy to .env.local for local development.

# Medusa backend (areve-platform-api). Add the storefront URL to the backend's STORE_CORS.
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable key: Medusa admin → Settings → Publishable API Keys ("AREVÉ Storefront").
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Public URL of this storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default country (ISO-2, lowercase). AREVÉ sells in Nigeria.
NEXT_PUBLIC_DEFAULT_REGION=ng

# Paystack public key (pk_test_... locally). Used by the Paystack checkout step.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# WhatsApp number for click-to-chat, international format without "+" (e.g. 2348012345678).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Next.js on-demand revalidation secret.
REVALIDATE_SECRET=change-me
